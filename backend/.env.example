PROJECT_NAME=NetPulse
SECRET_KEY=
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Optional initial admin password (12+ characters, maximum 72 UTF-8 bytes).
BOOTSTRAP_ADMIN_PASSWORD=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database TimescaleDB (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://netpulse:netpulse_secret@localhost:5432/netpulse_db

# CORS (Frontend Domain)
CORS_ORIGINS=*

# Alert Channels (Reihan - Tahap 3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Alert Threshold Defaults
ALERT_CPU_THRESHOLD=85.0
ALERT_RAM_THRESHOLD=90.0
DEADMAN_TIMEOUT_SECONDS=30
